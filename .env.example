# Set distinct, random values before running the API.
CAUSENTRA_ANALYST_TOKEN=replace-with-random-analyst-token
CAUSENTRA_MANAGER_TOKEN=replace-with-random-manager-token
CAUSENTRA_DB=causentra.db
# Optional JSON map: {"random-token":{"role":"auditor","actor":"name","organization_id":"tenant-id"}}
CAUSENTRA_TOKENS_JSON=
# OpenAI-compatible chat completions endpoint on approved AMD infrastructure.
AMD_CHAT_COMPLETIONS_URL=
AMD_MODEL_ID=
AMD_API_KEY=
# Optional Evolus partner track configuration; workspace must connect to the AMD model.
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_AI_TOOL=
EVOLUS_SANDBOX_CONFIRMED=false
